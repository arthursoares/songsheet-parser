# Source material (copyrighted, not committed)
source/
*.pdf
/data/png/

# Materialized page images are rendered copyrighted scans — never commit.
data/*/songs/*/pages/
# Per-song corpus JSON is personal-use song data (kept local, like the scans).
data/*/songs/

# data/ is its own private git repo (github.com/arthursoares/songsheet-data)
# backing up the corrected corpus + scans; its metadata isn't ours to track.
data/.gitignore
data/README.md
data/*.json

# Playwright MCP artifacts (screenshots/snapshots from browser verification)
.playwright-mcp/

# Blog-post draft (published elsewhere; embeds corpus-derived stats)
draft-post.md
draft-post-charts/

# Throwaway prototypes / experiments (embed copyrighted song data — never commit)
experiments/

# Local extraction candidates and research artifacts can contain copyrighted source material.
.local/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
.vscode/
.idea/
